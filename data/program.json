      "id": "lock-left",
      "kind": "defense",
      "name": "Lock Left",
      "call": "",
      "summary": "Our defensive system. A style of defense centered around forcing offenses LEFT, with the goal of them making decisions and passes using their left hand.",
      "keys": [
        "NO RIGHT HAND DRIVES",
        "NO OPEN CATCH AND SHOOT THREES"
      ],
      "reads": [],
      "updated": "2026-11-18"
    },
    {
      "id": "advantage-basketball",
      "kind": "concept",
      "name": "Advantage Basketball",
      "call": "“Keep it!”",
      "summary": "Once we create an advantage — we beat a man, or the defense has to help — the next action has to keep it. Drive, kick, swing. Don't hold it.",
      "keys": [
        "Catch with your feet ready to shoot, drive or pass",
        "Make your decision in half a second",
        "A good shot now beats a great shot later only if the advantage is gone"
      ],
      "reads": [],
      "updated": "2026-11-18",
      "example": true
    },
    {
      "id": "spacing",
      "kind": "concept",
      "name": "Spacing",
      "call": "“Space!”",
      "summary": "Keep 15 to 18 feet between teammates so one defender can't guard two of us.",
      "keys": [
        "If you can hand it to a teammate, you're too close",
        "Corners are spots, not suggestions",
        "When a teammate cuts, fill the spot they left"
      ],
      "reads": [],
      "updated": "2026-11-18",
      "example": true
    },
    {
