      "kind": "principle",
      "name": "Paint Touch Before a Three",
      "call": "",
      "summary": "Get the ball into the paint, by a drive or a post feed, before we take a three. Kick-out threes are our best threes.",
      "keys": [
        "Drive or post feed first",
        "Exception: a wide-open catch-and-shoot in transition"
      ],
      "reads": [],
      "updated": "2026-11-18",
